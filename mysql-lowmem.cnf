# Low-memory MariaDB/MySQL settings (local + staging).
# Mounted by docker-compose.yml into /etc/mysql/conf.d/. The site's database is ~12 MB,
# so a 64 MB buffer pool is plenty, and performance_schema alone uses ~100+ MB.
[mysqld]
performance_schema      = OFF
innodb_buffer_pool_size = 64M
innodb_log_buffer_size  = 8M
key_buffer_size         = 8M
max_connections         = 40
table_open_cache        = 400
tmp_table_size          = 16M
max_heap_table_size     = 16M
