APP_NAME="default"
APP_ENV=local

STATAMIC_CONTAINER=statamic_default
STATAMIC_HOST=default.localhost
STATAMIC_SSL_PORT=8462 ## SSL in local, but actually is the FPM_PORT in remote, no the SSL_PORT, since TLS is handled by host NGINX in remote. We will keep the name ,but it's good to know what actually this is for.
STATAMIC_DEBUG=false
STATAMIC_CUSTOM_LOGO_OUTSIDE_URL="/visuals/default.svg"
STATAMIC_URL="https://${STATAMIC_HOST}:${STATAMIC_SSL_PORT}"

NODE_CONTAINER=node_default
NODE_PORT=5175 # 5173 


COMPOSE_PROFILES=local-only # ONLY local, comment in remote
#COMPOSE_FILE=docker-compose.yml:docker-compose.remote.yml # ONLY remote, comment in LOCAL

LOG_CHANNEL=stack
LOG_LEVEL=debug

CADDY_CONTAINER=caddy_default

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

OPCACHE_VALIDATE_TIMESTAMPS=1 # "1" is a dev-friendly setting. In production it is commonly set more aggressively for performance -> "0".
