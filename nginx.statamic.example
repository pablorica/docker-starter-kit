# TM-Studio NGINX as proxy server
# /etc/nginx/sites-available/tm-studio 
server {
    listen 80;
    listen [::]:80;
    server_name tm-studio.co.uk www.tm-studio.co.uk; 

    root /data/webs/tm-studio/statamic/public;   # HOST path (bind-mount source) → static files
    index index.php index.html;
    client_max_body_size 50M;
    error_log /var/log/nginx/tm-studio.error.log;

    location = /favicon.ico { log_not_found off; access_log off; }
    location = /robots.txt  { allow all; log_not_found off; access_log off; }
    location ~ /\.(?!well-known).* { deny all; }   # block dotfiles, keep ACME renewals working

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;                                        # don't hand ghost scripts to FPM
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public$fastcgi_script_name;  # CONTAINER path
        fastcgi_param DOCUMENT_ROOT   /var/www/html/public;                       # CONTAINER path
        fastcgi_pass 127.0.0.1:8463;                                # == 127.0.0.1:${STATAMIC_SSL_PORT}
        fastcgi_read_timeout 300;
        fastcgi_intercept_errors on;
    }

    location ~* \.(css|js|jpg|jpeg|png|gif|svg|webp|ico|woff|woff2|ttf)$ {
        expires 7d;
        access_log off;
        try_files $uri =404;
    }
}