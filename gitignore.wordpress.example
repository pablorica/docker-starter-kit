# .gitignore template for WordPress + Sage projects (gitignore.wordpress.example): new-wp-sage.sh replaces __THEME__ with the theme folder name.

# ignore everything in the root except the  files and folders specified below
/*

# ignore all files starting with . or ~
.*
~*

# ignore node dependency directories
node_modules/
dist/

# ignore OS generated files
ehthumbs.db
Thumbs.db
.Trashes

# ignore Editor files
*.sublime-project
*.sublime-workspace
*.komodoproject

# ignore log files and databases
*.log
*.sql
*.sqlite

# ignore compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# ignore packaged files
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# ignore files that a local computer might use for its own convenience
.DS_Store
*.swp
*.pyc



# local build tools
.vagrant
.idea
*.sassc
*.scssc
*.codekit
*.sh
*.orig

# Ignore potentially dangerous files (dependabot alerts)
yarn.lock
#package-lock.json


# Ignore builder files and folders
/node_modules
/vendor
/public/*
/.env
/.budfiles
/npm-debug.log
/yarn-error.log
/yarn.lock
#/package-lock.json
/composer.lock
#/theme.json


# -------------------------
# SSL
# -------------------------

# Ignore SSL certificates
/certs
/certs/*
*.pem


# -------------------------
# Logs
# -------------------------

# Ignore logs
/logs
/logs/*
*.log

# -------------------------
# Wordpress
# -------------------------

# Track the "wordpress" directory and the outher no-wordpress folders.
!wordpress

# ignore everything in the "wordpress" directory, except "wp-content"
wordpress/*
!wordpress/wp-content/


# ignore everything in the "wp-content" directory, except:
# mu-plugins, plugins, and themes directories
wordpress/wp-content/*
!wordpress/wp-content/mu-plugins/
!wordpress/wp-content/plugins/
!wordpress/wp-content/themes/

# ignore all mu-plugins, plugins, and themes
# unless explicitly whitelisted at the end of this file
wordpress/wp-content/mu-plugins/*
wordpress/wp-content/plugins/*
wordpress/wp-content/themes/*



# -------------------------
# BEGIN Whitelisted Files
# -------------------------

# track these files, if they exist
!.gitignore
!.editorconfig
!.phpcs.xml.dist
!composer.json
!theme.json
# Migration file
!*.sql.gz

# Markdown files
!README.md
!CHANGELOG.md

# Docs
!docs/

# track example files, if they exist
!*.example

# track staging files, if they exist
!*.staging

# track favicon files, if they exist
!android-chrome-*.png
!apple-touch-icon*.png
!browserconfig.xml
!favicon*.png
!favicon*.ico
!manifest.json
!mstile-*.png
!safari-pinned-tab.svg
!site.webmanifest

# Docker
!docker-compose.yml
!docker-compose.remote.yml
!Caddyfile
!docker


# Wordpress: track these mu-plugins, plugins, and themes


# WPML Plugin: These files were updated to prevent fatal errors caused by incompatibilities between the WPML plugin and SAGE
#!wp-content/plugins/wpml-string-translation/


# Theme
!wordpress/wp-content/themes/__THEME__/

# Ignore dist folder of theme
wordpress/wp-content/themes/__THEME__/dist
# Ignore development Files
wordpress/wp-content/themes/__THEME__/node_modules
wordpress/wp-content/themes/__THEME__/vendor
wordpress/wp-content/themes/__THEME__/.env
wordpress/wp-content/themes/__THEME__/.budfiles
wordpress/wp-content/themes/__THEME__/npm-debug.log
wordpress/wp-content/themes/__THEME__/yarn-error.log
wordpress/wp-content/themes/__THEME__/yarn.lock
#wordpress/wp-content/themes/__THEME__/package-lock.json
#wordpress/wp-content/themes/__THEME__/composer.lock
wordpress/wp-content/themes/__THEME__/assets/css/style.css
wordpress/wp-content/themes/__THEME__/assets/css/*.map
#wordpress/wp-content/themes/__THEME__/theme.json


# Track public
!wordpress/wp-content/themes/__THEME__/public/
# Ignore everything inside public
#wordpress/wp-content/themes/__THEME__/public/*
# But track the Vite build output
#!wordpress/wp-content/themes/__THEME__/public/build/
#!wordpress/wp-content/themes/__THEME__/public/build/**