
# .env — LOCAL development (created from env.wordpress by new-wp-sage.sh)
# ${...} values are filled in by Docker Compose from the lines above them,
# so most settings follow PROJECT_NAME and the ports automatically.

PROJECT_NAME=default           # slug: names the containers (default_mysql…), volumes and local domain
COMPOSE_PROFILES=dev           # dev = also run caddy + the node watcher. Empty = core services only
APP_ENV=local

# --- MySQL ---
MYSQL_DATABASE=${PROJECT_NAME}
MYSQL_USER=pablo
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- WordPress ---
WORDPRESS_PORT=8080            # optional HTTP listener; unused while Caddy terminates TLS
WORDPRESS_SSL_PORT=8443        # also the public Caddy HTTPS port (all vhosts share it via SNI)
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_HOME=https://${PROJECT_NAME}.localhost:${WORDPRESS_SSL_PORT}   # NO trailing slash
WORDPRESS_DEBUG=true
WORDPRESS_THEMENAME=template
VITE_PATH=/wp-content/themes/${WORDPRESS_THEMENAME}/public/build/
ACF_PRO_LICENSE=

# --- WordPress salts ---
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=

# --- phpMyAdmin ---
PHPMYADMIN_PORT=8081           # local: unused (served by Caddy on pma.<project>.localhost); server: phpMyAdmin port

# --- Caddy ---
CADDY_HOSTNAME=${PROJECT_NAME}.localhost
CADDY_PRODUCTION_DOMAIN=example.com

# --- Node ---
NODE_PORT=5173

# Derived in docker-compose.yml from PROJECT_NAME (no longer set here):
#   <project>_mysql, <project>_wordpress, <project>_phpmyadmin, <project>_caddy, <project>_node
#   MySQL host = mysql:3306
